{
  "manifest_version": 3,
  "name": "PaperFlow AI",
  "description": "A persistent AI research companion beside every paper.",
  "version": "0.7.0",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["sidePanel", "storage", "tabs", "nativeMessaging", "contextMenus"],
  "host_permissions": ["https://arxiv.org/*", "https://export.arxiv.org/*", "https://openreview.net/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/paperflow-16.png",
    "32": "icons/paperflow-32.png",
    "48": "icons/paperflow-48.png",
    "128": "icons/paperflow-128.png"
  },
  "action": {
    "default_title": "Open PaperFlow AI",
    "default_icon": {
      "16": "icons/paperflow-16.png",
      "32": "icons/paperflow-32.png"
    }
  },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js", "type": "module" }
}
