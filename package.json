{
  "name": "paperflow-ai",
  "private": true,
  "version": "0.7.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "native:check": "cargo check --all-targets --manifest-path native-host/Cargo.toml",
    "native:test": "cargo test --manifest-path native-host/Cargo.toml",
    "native:build": "cargo build --release --manifest-path native-host/Cargo.toml",
    "package": "pnpm build && cd dist && zip -qr ../paperflow-ai.zip ."
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-ris": "^0.9.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "latest",
    "dexie": "^4.4.6",
    "lucide-react": "latest",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tesseract.js": "^7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.6.5",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "latest",
    "@types/node": "^26.6.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.1"
  }
}
